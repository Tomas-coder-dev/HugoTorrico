@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Bienvenido</h1>
        <p class="lead">Accesos rápidos para administrar la aplicación.</p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Productos</h5>
                    <p class="card-text">Ver, crear y editar productos.</p>
                    <div class="mt-auto">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm me-2">Ver productos</a>
                        <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary btn-sm">Nuevo</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Clientes</h5>
                    <p class="card-text">Ver, crear y editar clientes.</p>
                    <div class="mt-auto">
                        <a asp-controller="Customers" asp-action="Index" class="btn btn-primary btn-sm me-2">Ver clientes</a>
                        <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-primary btn-sm">Nuevo</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Facturas</h5>
                    <p class="card-text">Gestionar facturas (cabeceras).</p>
                    <div class="mt-auto">
                        <a asp-controller="Invoices" asp-action="Index" class="btn btn-primary btn-sm me-2">Ver facturas</a>
                        <a asp-controller="Invoices" asp-action="Create" class="btn btn-outline-primary btn-sm">Nueva</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Detalles</h5>
                    <p class="card-text">Ver y crear líneas de detalle.</p>
                    <div class="mt-auto">
                        <a asp-controller="Details" asp-action="Index" class="btn btn-primary btn-sm me-2">Ver detalles</a>
                        <a asp-controller="Details" asp-action="Create" class="btn btn-outline-primary btn-sm">Nuevo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Home" asp-action="Privacy" class="btn btn-link">Privacidad</a>
        <a asp-controller="Home" asp-action="About" class="btn btn-link">Acerca de</a>
        <a href="/swagger" class="btn btn-link">API (Swagger)</a>
    </div>

    <p class="text-center text-muted small mt-3">Si algún enlace falla, verifica que el controlador y la acción existen con esos nombres.</p>
</div>